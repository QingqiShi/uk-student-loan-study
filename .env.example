# PostHog Configuration
# Project token: PostHog → Settings → Project ID (starts with `phc_`).
# Public, write-only ingestion key — safe to ship in the client bundle.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here

# Ingestion host. This is PostHog's managed reverse proxy, on our own domain,
# so ad blockers that list *.posthog.com do not drop events.
# Direct ingestion (no proxy) is https://eu.i.posthog.com — note the `.i.`,
# without which every event is dropped.
NEXT_PUBLIC_POSTHOG_HOST=https://f.studentloanstudy.uk
